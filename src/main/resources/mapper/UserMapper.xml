<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.template.mapper.UserMapper">

    <resultMap id="UserResultMap" type="com.example.template.entity.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="email" column="email"/>
        <result property="age" column="age"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="deleted" column="deleted"/>
    </resultMap>

    <!--
        Single-table CRUD (insert / update / select / delete / count) is generated
        automatically by BaseMapper via @InsertProvider / @UpdateProvider etc. This
        XML file hosts only mapper-specific queries that don't fit the generic
        pattern. Add new custom methods here as your domain grows.
    -->

    <select id="findByEmailLike" resultMap="UserResultMap">
        SELECT id, username, email, age, created_at, updated_at, created_by, updated_by, deleted
        FROM users
        WHERE email LIKE #{pattern}
        AND deleted = 0
        ORDER BY id DESC
    </select>

</mapper>